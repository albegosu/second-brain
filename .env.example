# Shortcut token (its sha256 is registered in Supabase)
INBOX_TOKEN=generate_one_with_openssl_rand_hex_24

# worker
INBOX_URL=http://localhost:8000
BRAIN_MEDIA=./data/media
BRAIN_VLM=gemma4:31b-cloud
BRAIN_COOKIES=firefox
OLLAMA_HOST=http://localhost:11434
# without a local Ollama: OLLAMA_HOST=https://ollama.com, BRAIN_VLM=gemma4:31b and the API key
# OLLAMA_API_KEY=...
POLL_INTERVAL=60
# the wiki/ folder of the private wiki repository
BRAIN_WIKI=../second-brain-wiki/wiki
# automatic commit and push of the wiki after each capture (unsigned)
BRAIN_GIT_SYNC=1
# Supabase inbox (optional; without it the local inbox is used). See db/supabase.sql
SUPABASE_URL=https://<project>.supabase.co
SUPABASE_KEY=sb_publishable_...
WORKER_TOKEN=generate_one_with_openssl_rand_hex_24
# phone notification when each capture is done (ntfy app subscribed to this topic)
NTFY_TOPIC=second-brain-generate_one_with_openssl_rand_hex_12
