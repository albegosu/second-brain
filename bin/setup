#!/usr/bin/env python3
"""Sets up second-brain end to end: the Supabase inbox, your private wiki
repository, its secrets and your devices.

    bin/setup                                   # asks for what it needs
    bin/setup --name my-wiki --supabase-ref abcd1234

In order:
0. Sets up the inbox where captures wait. By default a private inbox
   repository (<name>-inbox) whose workflow files captures into the wiki with a
   deploy key, plus a capture token you create for it that can write there and
   nowhere else. Or, with --inbox supabase, a Supabase project: with an access
   token and no project given, it creates one and waits until it's ready.
1. Creates the private GitHub repository from templates/wiki-repo (workflows,
   README, an empty wiki) and clones it locally.
2. Generates the capture and worker tokens and an ntfy topic.
3. Sets the repository secrets: the model provider's key (OLLAMA_API_KEY, or
   BRAIN_API_KEY plus the BRAIN_PROVIDER variable for openai, anthropic, gemini
   or openrouter), SUPABASE_URL, SUPABASE_KEY, WORKER_TOKEN and NTFY_TOPIC.
4. Sets up the Supabase inbox: db/supabase.sql, the token hashes and the Vault
   values the capture trigger reads. With a Supabase access token it runs the
   SQL itself; without one it writes the SQL to a file for the SQL editor.
5. Adds what's missing to the engine's .env and, on macOS, optionally installs
   a LaunchAgent that pulls the wiki every 15 minutes and links the skill.
6. Prints how to connect each device: the Shortcut's three values, and a
   setup link for the capture page, also as a QR code to scan with the phone
   (if the `qrencode` command or the `segno` or `qrcode` Python package is
   available).

Needs git and a logged-in gh. Standard library only, so it runs before the
virtualenv exists. Secrets come from hidden prompts or the environment
(OLLAMA_API_KEY, BRAIN_API_KEY, SUPABASE_ACCESS_TOKEN, SUPABASE_KEY, GITHUB_DISPATCH_TOKEN), never from the
command line. Use a Supabase project dedicated to this wiki: its token hashes
are replaced.
"""
from __future__ import annotations

import argparse
import base64
import getpass
import hashlib
import json
import os
import platform
import plistlib
import re
import secrets
import shutil
import subprocess
import sys
import tempfile
import time
import urllib.error
import urllib.request
from pathlib import Path

ENGINE = Path(__file__).resolve().parent.parent
TEMPLATE = ENGINE / "templates" / "wiki-repo"
INBOX_TEMPLATE = ENGINE / "templates" / "inbox-repo"
PAT_URL = "https://github.com/settings/personal-access-tokens/new"
SCHEMA = ENGINE / "db" / "supabase.sql"
UPSTREAM = "albegosu/second-brain"
SUPABASE_API = "https://api.supabase.com/v1"
MODEL_KEYS = {  # provider: where to get an API key
    "ollama": "ollama.com/settings/keys",
    "openai": "platform.openai.com/api-keys",
    "anthropic": "console.anthropic.com/settings/keys",
    "gemini": "aistudio.google.com/apikey",
    "openrouter": "openrouter.ai/keys",
}
CAPTURE_PAGE = "https://albegosu.github.io/second-brain/"  # web/, for Android and desktop
INDEX = """# Second brain

Generated by the worker from each page's frontmatter: edits here are overwritten.
Nothing captured yet: share something with the Shortcut.
"""


def step(message: str):
    print(f"\n==> {message}")


def fail(message: str):
    sys.exit(f"\nsetup: {message}")


def sh(*cmd: str, stdin: str | None = None, cwd: Path | None = None) -> str:
    r = subprocess.run(cmd, input=stdin, cwd=cwd, text=True, capture_output=True)
    if r.returncode:
        fail(f"`{' '.join(cmd[:3])}` failed: {(r.stderr or r.stdout).strip()[:400]}")
    return r.stdout.strip()


def ask(prompt: str, *, default: str = "", secret: bool = False, env: str | None = None,
        required: bool = True) -> str:
    if env and os.environ.get(env):
        return os.environ[env].strip()
    if not sys.stdin.isatty():
        if required and not default:
            fail(f"missing {env or prompt} (no terminal to ask)")
        return default
    label = f"{prompt}{f' [{default}]' if default else ''}: "
    while True:
        value = (getpass.getpass(label) if secret else input(label)).strip() or default
        if value or not required:
            return value


def confirm(prompt: str, default: bool = True) -> bool:
    if not sys.stdin.isatty():
        return default
    answer = input(f"{prompt} [{'Y/n' if default else 'y/N'}]: ").strip().lower()
    return default if not answer else answer.startswith("y")


def supabase(token: str, method: str, path: str, body: dict | None = None):
    """Supabase Management API. Raises RuntimeError with the API's message."""
    request = urllib.request.Request(
        f"{SUPABASE_API}{path}", method=method,
        data=json.dumps(body).encode() if body is not None else None,
        headers={"Authorization": f"Bearer {token}", "Content-Type": "application/json",
                 "User-Agent": "second-brain-setup"})
    try:
        with urllib.request.urlopen(request, timeout=120) as response:
            raw = response.read()
    except urllib.error.HTTPError as e:
        raise RuntimeError(f"{e.code} {e.read().decode(errors='replace')[:300]}") from e
    return json.loads(raw) if raw else None


def create_project(token: str, name: str) -> str:
    """Creates a Supabase project for the inbox and waits until it's up. Returns its ref."""
    orgs = supabase(token, "GET", "/organizations") or []
    if not orgs:
        fail("this Supabase account has no organization: create one at supabase.com/dashboard")
    org = orgs[0]
    if len(orgs) > 1:
        for i, o in enumerate(orgs, 1):
            print(f"    {i}. {o.get('name')}")
        choice = ask("Supabase organization for the project", default="1")
        org = orgs[int(choice) - 1] if choice.isdigit() and 0 < int(choice) <= len(orgs) else orgs[0]
    region = ask("Supabase region (closest to you: eu-central-1, eu-west-1, us-east-1, ap-southeast-1…)",
                 default="eu-central-1")
    body = {"name": name, "region": region, "db_pass": secrets.token_urlsafe(24)}
    try:  # newer API takes the organization's slug, older its id
        project = supabase(token, "POST", "/projects", {**body, "organization_slug": org.get("slug") or org["id"]})
    except RuntimeError:
        project = supabase(token, "POST", "/projects", {**body, "organization_id": org["id"]})
    ref = project.get("ref") or project.get("id")
    print(f"    created {ref}; waiting for it to start (a minute or two)", end="", flush=True)
    for _ in range(90):
        time.sleep(5)
        status = (supabase(token, "GET", f"/projects/{ref}") or {}).get("status", "")
        if status == "ACTIVE_HEALTHY":
            print(" ready")
            return ref
        print(".", end="", flush=True)
    fail(f"project {ref} isn't ready after 7 minutes: run bin/setup again with --supabase-ref {ref}")


def qr(text: str) -> str | None:
    """The text as a QR code for the terminal, if a QR tool is around."""
    if shutil.which("qrencode"):
        r = subprocess.run(["qrencode", "-t", "ANSIUTF8", "-m", "2", text], capture_output=True, text=True)
        if r.returncode == 0:
            return r.stdout
    try:
        import segno
        import io
        out = io.StringIO()
        segno.make(text, error="l").terminal(out=out, compact=True, border=2)
        return out.getvalue()
    except ImportError:
        pass
    try:
        import qrcode
        import io
        code, out = qrcode.QRCode(border=2), io.StringIO()
        code.add_data(text)
        code.print_ascii(out=out, invert=True)
        return out.getvalue()
    except ImportError:
        return None


def publishable_key(token: str, ref: str) -> str | None:
    keys = supabase(token, "GET", f"/projects/{ref}/api-keys") or []
    for wanted in ("publishable", "legacy"):  # new sb_publishable_ keys first, then the anon key
        for key in keys:
            if key.get("api_key") and (key.get("type") == wanted if wanted == "publishable" else key.get("name") == "anon"):
                return key["api_key"]
    return None


def literal(value: str) -> str:
    return "'" + value.replace("'", "''") + "'"


def vault(name: str, value: str) -> str:
    """Creates or replaces a Vault secret."""
    return (f"do $$ begin\n"
            f"  if exists (select 1 from vault.secrets where name = {literal(name)}) then\n"
            f"    perform vault.update_secret((select id from vault.secrets where name = {literal(name)}), {literal(value)});\n"
            f"  else\n"
            f"    perform vault.create_secret({literal(value)}, {literal(name)});\n"
            f"  end if;\n"
            f"end $$;\n")


def setup_link(settings: dict) -> str:
    """The capture page's settings in the URL fragment, which browsers never send
    to the server (web/app.js reads it and drops it from the address bar)."""
    data = json.dumps(settings, separators=(",", ":"))
    return f"{CAPTURE_PAGE}#setup={base64.urlsafe_b64encode(data.encode()).decode().rstrip('=')}"


def setup_sql(repo: str, capture_token: str, worker_token: str) -> str:
    digest = lambda s: hashlib.sha256(s.encode()).hexdigest()
    return "\n".join([
        SCHEMA.read_text(),
        "-- Added by bin/setup: token hashes and where the capture trigger dispatches to.",
        "insert into private.tokens values "
        f"('capture', {literal(digest(capture_token))}), ('worker', {literal(digest(worker_token))})",
        "on conflict (name) do update set sha256 = excluded.sha256;",
        vault("github_dispatch_repo", repo),
    ])


def merge_env(path: Path, values: dict[str, str]) -> list[str]:
    """Appends the keys the file doesn't have. Returns the keys it already had
    with a different value, which are left alone."""
    lines = path.read_text().splitlines() if path.exists() else []
    existing = {}
    for line in lines:
        key, sep, value = line.partition("=")
        if sep and not line.lstrip().startswith("#"):
            existing[key.strip()] = value.strip()
    missing = [f"{k}={v}" for k, v in values.items() if k not in existing]
    if missing:
        with path.open("a") as fh:
            fh.write(("\n" if lines and lines[-1].strip() else "") + "# added by bin/setup\n" + "\n".join(missing) + "\n")
    if path.exists():
        path.chmod(0o600)
    return [k for k, v in values.items() if k in existing and existing[k] != v]


def launch_agent(name: str, wiki_repo: Path):
    label = f"com.second-brain.pull.{re.sub(r'[^a-z0-9-]+', '-', name.lower())}"
    plist = Path.home() / "Library" / "LaunchAgents" / f"{label}.plist"
    log = Path.home() / "Library" / "Logs" / f"{label}.log"
    plist.parent.mkdir(parents=True, exist_ok=True)
    plist.write_bytes(plistlib.dumps({
        "Label": label,
        "ProgramArguments": [shutil.which("git") or "/usr/bin/git", "-C", str(wiki_repo), "pull", "--ff-only", "-q"],
        "RunAtLoad": True,
        "StartInterval": 900,
        "StandardOutPath": str(log),
        "StandardErrorPath": str(log),
    }))
    domain = f"gui/{os.getuid()}"
    subprocess.run(["launchctl", "bootout", f"{domain}/{label}"], capture_output=True)
    sh("launchctl", "bootstrap", domain, str(plist))
    return label


def engine_repository() -> str:
    url = subprocess.run(["git", "-C", str(ENGINE), "remote", "get-url", "origin"],
                         capture_output=True, text=True).stdout.strip()
    m = re.search(r"github\.com[:/]([^/\s]+/[^/\s]+?)(?:\.git)?$", url)
    return m.group(1) if m else UPSTREAM


def main():
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--name", default="second-brain-wiki", help="repository name (default: second-brain-wiki)")
    ap.add_argument("--dir", help="local clone (default: next to the engine, named like the repository)")
    ap.add_argument("--owner", help="GitHub user or organization (default: the logged-in user)")
    ap.add_argument("--inbox", choices=["github", "supabase"], help="where captures wait (default: ask; github)")
    ap.add_argument("--supabase-ref", help="Supabase project ref, or its https://<ref>.supabase.co URL")
    ap.add_argument("--env-file", type=Path, default=ENGINE / ".env", help="engine settings to complete")
    ap.add_argument("--no-launch-agent", action="store_true", help="don't install the macOS pull LaunchAgent")
    ap.add_argument("--no-skill", action="store_true", help="don't link the skill into ~/.claude/skills")
    args = ap.parse_args()

    step("Checking git and gh")
    for tool in ("git", "gh"):
        if not shutil.which(tool):
            fail(f"{tool} isn't installed")
    if subprocess.run(["gh", "auth", "status"], capture_output=True).returncode:
        fail("gh isn't logged in: run `gh auth login` first")
    owner = args.owner or sh("gh", "api", "user", "-q", ".login")
    repo = f"{owner}/{args.name}"
    dest = Path(args.dir).expanduser().resolve() if args.dir else ENGINE.parent / args.name
    if dest.exists() and any(dest.iterdir()):
        fail(f"{dest} already exists and isn't empty")
    if subprocess.run(["gh", "repo", "view", repo], capture_output=True).returncode == 0:
        fail(f"{repo} already exists on GitHub")
    engine = engine_repository()
    engine_private = sh("gh", "repo", "view", engine, "--json", "visibility", "-q", ".visibility") != "PUBLIC"
    print(f"    wiki repository {repo} (private) at {dest}\n    engine {engine}")

    step("Inbox")
    print("    Where captures wait before they're filed:\n"
          "      github    a small private inbox repository next to the wiki (nothing else to sign up for)\n"
          "      supabase  a free Supabase project (needed by the iPhone and Mac Shortcut for now)")
    kind = args.inbox or ask("Inbox", default="github").lower()
    if kind not in ("github", "supabase"):
        fail(f"unknown inbox {kind!r}: use github or supabase")
    inbox_repo = f"{repo}-inbox"
    access = ref = key = ""
    if kind == "github":
        if subprocess.run(["gh", "repo", "view", inbox_repo], capture_output=True).returncode == 0:
            fail(f"{inbox_repo} already exists on GitHub")
    else:
        access, ref, key = supabase_questions(args)

    step("Model")
    print("    ollama (free cloud plan, the default), openai, anthropic, gemini or openrouter.")
    provider = ask("Model provider", default="ollama", env="BRAIN_PROVIDER").lower()
    if provider not in MODEL_KEYS:
        fail(f"unknown provider {provider!r}: use {', '.join(MODEL_KEYS)}")
    model_key = ask(f"{provider.capitalize()} API key ({MODEL_KEYS[provider]})", secret=True,
                    env="OLLAMA_API_KEY" if provider == "ollama" else "BRAIN_API_KEY")
    model = "" if provider == "ollama" else ask("Model (Enter for the default)", env="BRAIN_VLM", required=False)

    step(f"Creating {repo}")
    dest.mkdir(parents=True, exist_ok=True)
    shutil.copytree(TEMPLATE, dest, dirs_exist_ok=True)
    if kind == "github":  # the inbox repository runs the capture workflow instead
        (dest / ".github" / "workflows" / "capture.yml").unlink()
    (dest / "wiki").mkdir(exist_ok=True)
    (dest / "wiki" / "index.md").write_text(INDEX)
    push_new_repo(dest, repo, "chore: start the wiki", "Private second-brain wiki")

    ntfy_topic = f"second-brain-{secrets.token_hex(12)}"
    model_secret = "OLLAMA_API_KEY" if provider == "ollama" else "BRAIN_API_KEY"
    worker_repos = [repo] + ([inbox_repo] if kind == "github" else [])

    if kind == "github":
        step(f"Creating {inbox_repo}")
        inbox_dest = Path(tempfile.mkdtemp(prefix="second-brain-inbox-"))
        shutil.copytree(INBOX_TEMPLATE, inbox_dest, dirs_exist_ok=True)
        push_new_repo(inbox_dest, inbox_repo, "chore: start the inbox", "second-brain inbox: captures waiting to be filed")
        shutil.rmtree(inbox_dest, ignore_errors=True)
        # The inbox's workflow writes the wiki with a deploy key that only it holds.
        with tempfile.TemporaryDirectory() as tmp:
            keyfile = Path(tmp) / "key"
            sh("ssh-keygen", "-q", "-t", "ed25519", "-N", "", "-C", f"{inbox_repo} worker", "-f", str(keyfile))
            sh("gh", "repo", "deploy-key", "add", str(keyfile.with_suffix(".pub")), "-R", repo,
               "--allow-write", "--title", f"second-brain inbox ({inbox_repo})")
            sh("gh", "secret", "set", "WIKI_DEPLOY_KEY", "-R", inbox_repo, stdin=keyfile.read_text())
        sh("gh", "variable", "set", "WIKI_REPOSITORY", "-R", inbox_repo, "--body", repo)
        print(f"    deploy key: {inbox_repo} can write to {repo}")

    step("Setting repository secrets")
    for target in worker_repos:
        if engine != UPSTREAM:
            sh("gh", "variable", "set", "ENGINE_REPOSITORY", "-R", target, "--body", engine)
        if provider != "ollama":
            sh("gh", "variable", "set", "BRAIN_PROVIDER", "-R", target, "--body", provider)
            if model:
                sh("gh", "variable", "set", "BRAIN_VLM", "-R", target, "--body", model)
    values = {model_secret: model_key, "NTFY_TOPIC": ntfy_topic}
    sql_file = None
    if kind == "supabase":
        capture_token, worker_token = secrets.token_hex(24), secrets.token_hex(24)
        supabase_url = f"https://{ref}.supabase.co"
        values.update(SUPABASE_URL=supabase_url, SUPABASE_KEY=key, WORKER_TOKEN=worker_token)
    for target in worker_repos:
        for name, value in values.items():
            if target == repo and kind == "github" and name == "NTFY_TOPIC":
                continue  # the wiki only runs the lint pass
            sh("gh", "secret", "set", name, "-R", target, stdin=value)
            print(f"    {target}: {name}")

    if kind == "github":
        step("Capture token")
        print(f"""    Your devices write captures into {inbox_repo} with a fine-grained token that
    can reach that repository and nothing else. GitHub doesn't let a script create
    one, so it takes one minute by hand:
      1. Open {PAT_URL}
      2. Repository access: Only select repositories → {inbox_repo}
      3. Permissions: Contents → Read and write. Generate and copy it.""")
        if sys.stdin.isatty() and shutil.which("open"):
            subprocess.run(["open", PAT_URL], capture_output=True)
        while True:
            capture_token = ask("Paste the token", secret=True, env="CAPTURE_TOKEN")
            problem = check_capture_token(capture_token, inbox_repo, repo)
            if not problem:
                break
            print(f"    {problem}")
            if not sys.stdin.isatty():
                fail(problem)
        settings = {"kind": "github", "repo": inbox_repo, "token": capture_token}
    else:
        sql_file = supabase_inbox(args, access, ref, repo, capture_token, worker_token)
        settings = {"kind": "supabase", "url": supabase_url, "key": key, "token": capture_token}

    step("Local settings")
    env = {"BRAIN_WIKI": str(dest / "wiki"), "BRAIN_GIT_SYNC": "1", "NTFY_TOPIC": ntfy_topic}
    if kind == "supabase":
        env.update(SUPABASE_URL=supabase_url, SUPABASE_KEY=key, INBOX_TOKEN=capture_token, WORKER_TOKEN=worker_token)
    conflicts = merge_env(args.env_file, env)
    print(f"    {args.env_file}" + (f" (kept your existing {', '.join(conflicts)})" if conflicts else ""))
    if platform.system() == "Darwin" and not args.no_launch_agent and confirm("    Pull the wiki every 15 minutes (LaunchAgent)?"):
        if any(part in dest.parts for part in ("Documents", "Desktop", "Downloads")):
            print("    macOS doesn't let LaunchAgents read Documents, Desktop or Downloads: move the clone first")
        else:
            print(f"    installed {launch_agent(args.name, dest)}")
    skills = Path.home() / ".claude" / "skills" / "second-brain"
    if not args.no_skill and not skills.exists() and confirm("    Link the skill into ~/.claude/skills?"):
        skills.parent.mkdir(parents=True, exist_ok=True)
        skills.symlink_to(ENGINE / "skill" / "second-brain")
        print(f"    linked {skills}")
    default_wiki = Path.home() / "Developer" / "second-brain-wiki" / "wiki"
    if dest / "wiki" != default_wiki:
        print(f"    the skill looks in {default_wiki} unless BRAIN_WIKI is set where your agent runs")

    link = setup_link(settings)
    code = qr(link)
    devices = f"""  • Connect your phone or computer: scan this with the phone's camera, or open
    the link on the device, then install the page (it holds the capture token;
    keep it private):
      {link}
""" + (f"{code}" if code else "")
    if kind == "supabase":
        devices += f"""  • iPhone or Mac: open "{ENGINE / 'shortcut' / 'Save to second-brain.shortcut'}"
    and answer its questions with:
      Supabase project URL   {supabase_url}
      Publishable key        {key}
      Capture token          {capture_token}
    (the token is also INBOX_TOKEN in {args.env_file.name}; keep it private)
"""
    else:
        devices += """  • iPhone: the page works in Safari (paste a link or choose an image), but
    only the Shortcut shows up in the share sheet, and it needs the Supabase inbox
    for now.
"""
    print(f"""
Done: https://github.com/{repo}

Next:
""" + (f"""  • Run {sql_file} in the Supabase SQL editor
    (https://supabase.com/dashboard/project/{ref}/sql/new).
""" if sql_file else "") + devices + f"""  • Phone notifications: install the ntfy app and subscribe to {ntfy_topic}
""" + (f"""  • Your engine {engine} is private: add a read-only deploy key as the README explains.
""" if engine_private else "") + """  • Share something: it shows up in the wiki within a few minutes.
""")


def push_new_repo(folder: Path, repo: str, message: str, description: str):
    sh("git", "init", "-q", "-b", "main", cwd=folder)
    sh("git", "add", "-A", cwd=folder)
    commit = subprocess.run(["git", "commit", "-q", "-m", message], cwd=folder)  # may ask for a GPG passphrase
    if commit.returncode:
        fail(f"git commit failed in {folder}")
    sh("gh", "repo", "create", repo, "--private", "--source", str(folder), "--remote", "origin", "--push",
       "--description", description)


def check_capture_token(token: str, inbox_repo: str, wiki_repo: str) -> str | None:
    """None if the token can write to the inbox and can't see the wiki."""
    def status(repo: str) -> tuple[int, dict]:
        # Through gh with the token as GH_TOKEN: no certificate setup needed in Python.
        r = subprocess.run(["gh", "api", f"repos/{repo}"], capture_output=True, text=True,
                           env={**os.environ, "GH_TOKEN": token, "GH_HOST": "github.com"})
        if r.returncode == 0:
            return 200, json.loads(r.stdout or "{}")
        m = re.search(r"HTTP (\d{3})", r.stderr)
        return int(m.group(1)) if m else 0, {}
    code, data = status(inbox_repo)
    if code == 401:
        return "GitHub doesn't accept that token."
    if code != 200:
        return f"The token can't see {inbox_repo}: select it under Repository access."
    if not (data.get("permissions") or {}).get("push"):
        return "The token can read the inbox but not write: set Contents to Read and write."
    if status(wiki_repo)[0] == 200:
        return (f"The token can also reach {wiki_repo}. Limit it to {inbox_repo} only, so a lost phone "
                "can't read your wiki.")
    return None


def supabase_questions(args) -> tuple[str, str, str]:
    """The Supabase access token, project ref (creating the project if asked) and publishable key."""
    print("    With a Supabase access token this sets up everything in Supabase for you,\n"
          "    including a new free project. Get one at supabase.com/dashboard/account/tokens.")
    access = ask("Supabase access token (Enter to skip and do the Supabase part by hand)",
                 secret=True, env="SUPABASE_ACCESS_TOKEN", required=False)
    ref = args.supabase_ref or ""
    if not ref:
        hint = "Enter to create a new one" if access else "a free project dedicated to this wiki"
        ref = ask(f"Supabase project ref or URL ({hint})", required=not access)
    if not ref:
        try:
            ref = create_project(access, args.name)
        except RuntimeError as e:
            fail(f"Supabase couldn't create the project ({e}); create it at supabase.com/dashboard "
                 "and run bin/setup again with --supabase-ref")
    ref = re.sub(r"^https?://([a-z0-9]+)\.supabase\.co.*$", r"\1", ref.strip().rstrip("/"))
    if not re.fullmatch(r"[a-z0-9]{20}", ref):
        fail(f"that doesn't look like a Supabase project ref: {ref!r}")
    key = None
    if access:
        try:
            key = publishable_key(access, ref)
        except RuntimeError as e:
            fail(f"Supabase didn't accept the access token for {ref}: {e}")
    key = key or ask("Supabase publishable key (Project Settings → API Keys)", env="SUPABASE_KEY")
    return access, ref, key


def supabase_inbox(args, access: str, ref: str, repo: str, capture_token: str, worker_token: str) -> Path | None:
    """Applies the schema, token hashes and Vault values, or writes them to a file."""
    step("Setting up the Supabase inbox")
    sql = setup_sql(repo, capture_token, worker_token)
    print("    For instant captures, create a fine-grained GitHub token at\n"
          f"    {PAT_URL} with access to\n"
          f"    {repo} only and Contents: Read and write. Without it, captures wait for the 6-hour run.")
    dispatch = ask("GitHub token for the capture trigger (Enter to skip)", secret=True,
                   env="GITHUB_DISPATCH_TOKEN", required=False) if access else ""
    if access:
        try:
            supabase(access, "POST", f"/projects/{ref}/database/query",
                     {"query": sql + (vault("github_dispatch_token", dispatch) if dispatch else "")})
            print("    schema, token hashes and Vault values applied")
            return None
        except RuntimeError as e:
            print(f"    the Supabase API refused the SQL ({e}); writing it to a file instead")
    sql_file = ENGINE / "data" / f"supabase-{args.name}.sql"
    sql_file.parent.mkdir(exist_ok=True)
    sql_file.write_text(sql + "\n-- For instant captures, add your GitHub token too:\n"
                        "-- select vault.create_secret('<token>', 'github_dispatch_token');\n")
    sql_file.chmod(0o600)
    print(f"    wrote {sql_file}")
    return sql_file

if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        fail("interrupted")
